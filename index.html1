unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n<\u002Fstyle>\n<style>\n  * { box-sizing: border-box; }\n  html { scroll-behavior: smooth; }\n  body { margin: 0; background: #faf8f5; color: #1c1c1a; font-family: \"IBM Plex Sans\", system-ui, sans-serif; font-size: 17px; line-height: 1.65; -webkit-font-smoothing: antialiased; }\n  a { color: #22574a; text-decoration: none; }\n  a:hover { color: #163a31; }\n  p { text-wrap: pretty; }\n  @media (max-width: 768px) {\n    .dn-desktop { display: none !important; }\n    .dn-burger { display: inline-flex !important; }\n  }\n  @media (min-width: 769px) {\n    .dn-menu-panel { display: none !important; }\n  }\n<\u002Fstyle>\n<\u002Fhelmet>\n\n<div style=\"max-width:100%;overflow-x:hidden;\">\n\n  \n\n\n  <header style=\"position:sticky;top:0;z-index:50;background:rgba(250,248,245,0.92);backdrop-filter:saturate(1.1);border-bottom:1px solid #e7e2d9;\">\n    <div style=\"max-width:1100px;margin:0 auto;padding:16px 24px;display:flex;align-items:center;gap:24px;flex-wrap:wrap;\">\n      <a href=\"#top\" style=\"display:flex;align-items:center;\">\n        <img src=\"https://deltanekretnine.rs/wp-content/uploads/2020/11/Logo-150.png\" alt=\"Delta nekretnine\" style=\"height:44px;width:auto;display:block;\">\n      <\u002Fa>\n      <nav class=\"dn-desktop\" style=\"display:flex;gap:28px;margin-left:auto;flex-wrap:wrap;align-items:center;font-size:15px;\">\n        <a href=\"#ponuda\" style=\"color:#3a3a36;\">Ponuda<\u002Fa>\n        <a href=\"#usluge\" style=\"color:#3a3a36;\">Usluge<\u002Fa>\n        <a href=\"#onama\" style=\"color:#3a3a36;\">O nama<\u002Fa>\n        <a href=\"#kontakt\" style=\"color:#3a3a36;\">Kontakt<\u002Fa>\n      <\u002Fnav>\n      <a class=\"dn-desktop\" href=\"tel:0649555579\" style=\"font-size:15px;font-weight:500;color:#1c1c1a;\">064/955 55 79<\u002Fa>\n      <a class=\"dn-desktop\" href=\"#kontakt\" style=\"background:#22574a;color:#fff;padding:11px 20px;border-radius:7px;font-weight:600;font-size:15px;\">Pošaljite upit<\u002Fa>\n      <button class=\"dn-burger\" sc-camel-on-click=\"{{ toggleMenu }}\" aria-label=\"Meni\" style=\"display:none;margin-left:auto;flex-direction:column;justify-content:center;gap:5px;background:transparent;border:none;cursor:pointer;padding:8px;\">\n        <span style=\"width:24px;height:2px;background:#1c1c1a;display:block;\"><\u002Fspan>\n        <span style=\"width:24px;height:2px;background:#1c1c1a;display:block;\"><\u002Fspan>\n        <span style=\"width:24px;height:2px;background:#1c1c1a;display:block;\"><\u002Fspan>\n      <\u002Fbutton>\n    <\u002Fdiv>\n    <sc-if value=\"{{ menuOpen }}\" hint-placeholder-val=\"{{ false }}\">\n      <div class=\"dn-menu-panel\" style=\"border-top:1px solid #e7e2d9;background:#faf8f5;padding:8px 24px 18px;display:flex;flex-direction:column;\">\n        <a href=\"#ponuda\" sc-camel-on-click=\"{{ closeMenu }}\" style=\"padding:13px 0;color:#3a3a36;font-size:16px;border-bottom:1px solid #efece4;\">Ponuda<\u002Fa>\n        <a href=\"#usluge\" sc-camel-on-click=\"{{ closeMenu }}\" style=\"padding:13px 0;color:#3a3a36;font-size:16px;border-bottom:1px solid #efece4;\">Usluge<\u002Fa>\n        <a href=\"#onama\" sc-camel-on-click=\"{{ closeMenu }}\" style=\"padding:13px 0;color:#3a3a36;font-size:16px;border-bottom:1px solid #efece4;\">O nama<\u002Fa>\n        <a href=\"#kontakt\" sc-camel-on-click=\"{{ closeMenu }}\" style=\"padding:13px 0;color:#3a3a36;font-size:16px;border-bottom:1px solid #efece4;\">Kontakt<\u002Fa>\n        <a href=\"tel:0649555579\" sc-camel-on-click=\"{{ closeMenu }}\" style=\"padding:14px 0 10px;color:#1c1c1a;font-weight:600;font-size:16px;\">064/955 55 79<\u002Fa>\n        <a href=\"#kontakt\" sc-camel-on-click=\"{{ closeMenu }}\" style=\"margin-top:8px;background:#22574a;color:#fff;padding:13px 20px;border-radius:7px;font-weight:600;font-size:15px;text-align:center;\">Pošaljite upit<\u002Fa>\n      <\u002Fdiv>\n    <\u002Fsc-if>\n  <\u002Fheader>\n\n  <a id=\"top\"><\u002Fa>\n\n  <sc-if value=\"{{ isDetail }}\" hint-placeholder-val=\"{{ false }}\">\n    <section style=\"padding:32px 24px clamp(64px,8vw,110px);\">\n      <div style=\"max-width:1100px;margin:0 auto;\">\n        <a sc-camel-on-click=\"{{ goHome }}\" style=\"display:inline-flex;align-items:center;gap:6px;font-size:15px;font-weight:600;cursor:pointer;margin-bottom:28px;\">‹ Nazad na ponudu<\u002Fa>\n        <div style=\"display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap;margin-bottom:24px;\">\n          <div style=\"min-width:0;\">\n            <p style=\"margin:0 0 8px;font-size:14px;letter-spacing:0.06em;text-transform:uppercase;color:#22574a;font-weight:600;\">{{ detailLocation }}<\u002Fp>\n            <h1 style=\"font-family:'Spectral',serif;font-weight:700;font-size:clamp(1.8rem,3.6vw,2.8rem);line-height:1.1;margin:0;color:#17170f;\">{{ detailTitle }}<\u002Fh1>\n          <\u002Fdiv>\n          <span style=\"font-family:'Spectral',serif;font-size:clamp(1.7rem,3vw,2.4rem);font-weight:700;color:#22574a;white-space:nowrap;\">{{ detailPrice }}<\u002Fspan>\n        <\u002Fdiv>\n        {{ detailMainImg }}\n        {{ detailThumbs }}\n        <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:clamp(32px,5vw,56px);margin-top:clamp(36px,5vw,56px);align-items:start;\">\n          <div style=\"max-width:65ch;\">\n            <h2 style=\"font-family:'Spectral',serif;font-weight:600;font-size:1.5rem;margin:0 0 16px;color:#17170f;\">Opis<\u002Fh2>\n            <sc-for list=\"{{ detailParas }}\" as=\"p\" hint-placeholder-count=\"3\">\n              <p style=\"margin:0 0 16px;color:#45453f;\">{{ p }}<\u002Fp>\n            <\u002Fsc-for>\n          <\u002Fdiv>\n          <div style=\"border:1px solid #e3ded3;border-radius:8px;padding:28px;background:#fff;\">\n            <h2 style=\"font-family:'Spectral',serif;font-weight:600;font-size:1.25rem;margin:0 0 14px;color:#17170f;\">Detalji<\u002Fh2>\n            <div style=\"font-size:15px;\">\n              <sc-for list=\"{{ detailRows }}\" as=\"r\" hint-placeholder-count=\"6\">\n                <div style=\"display:flex;justify-content:space-between;gap:16px;padding:10px 0;border-top:1px solid #efece4;\">\n                  <span style=\"color:#5a5a52;\">{{ r.label }}<\u002Fspan>\n                  <span style=\"color:#17170f;font-weight:500;text-align:right;\">{{ r.value }}<\u002Fspan>\n                <\u002Fdiv>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n            <h3 style=\"font-family:'Spectral',serif;font-weight:600;font-size:1.05rem;margin:22px 0 12px;color:#17170f;\">Karakteristike<\u002Fh3>\n            <div style=\"display:flex;flex-wrap:wrap;gap:8px;\">\n              <sc-for list=\"{{ detailFeatures }}\" as=\"f\" hint-placeholder-count=\"4\">\n                <span style=\"font-size:13px;color:#22574a;border:1px solid #cfe0d9;background:#f2f7f5;padding:5px 11px;border-radius:5px;\">{{ f }}<\u002Fspan>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n            <div style=\"display:flex;flex-direction:column;gap:10px;margin-top:24px;\">\n              <a href=\"tel:0649555579\" style=\"background:#22574a;color:#fff;padding:13px 20px;border-radius:7px;font-weight:600;font-size:15px;text-align:center;\">Pozovite 064/955 55 79<\u002Fa>\n              <a href=\"mailto:info@deltanekretnine.rs\" style=\"padding:13px 20px;border-radius:7px;font-weight:600;font-size:15px;text-align:center;border:1px solid #c9c2b4;color:#22574a;\">Pošaljite upit<\u002Fa>\n            <\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"margin-top:clamp(36px,5vw,56px);\">\n          <h2 style=\"font-family:'Spectral',serif;font-weight:600;font-size:1.5rem;margin:0 0 6px;color:#17170f;\">Lokacija<\u002Fh2>\n          <p style=\"margin:0 0 16px;color:#5a5a52;\">{{ detailMapLabel }}<\u002Fp>\n          {{ detailMap }}\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsection>\n  <\u002Fsc-if>\n\n  <sc-if value=\"{{ isCat }}\" hint-placeholder-val=\"{{ false }}\">\n    <section style=\"padding:32px 24px clamp(64px,8vw,110px);\">\n      <div style=\"max-width:1100px;margin:0 auto;\">\n        <a sc-camel-on-click=\"{{ goHome }}\" style=\"display:inline-flex;align-items:center;gap:6px;font-size:15px;font-weight:600;cursor:pointer;margin-bottom:24px;\">‹ Nazad na početnu<\u002Fa>\n        <h1 style=\"font-family:'Spectral',serif;font-weight:700;font-size:clamp(1.9rem,3.6vw,2.9rem);line-height:1.1;margin:0 0 10px;color:#17170f;\">{{ catTitle }}<\u002Fh1>\n        <p style=\"margin:0 0 clamp(28px,4vw,44px);color:#45453f;max-width:60ch;\">{{ catSub }}<\u002Fp>\n        <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:28px;\">\n          <sc-for list=\"{{ catItems }}\" as=\"c\" hint-placeholder-count=\"6\">\n            <div style=\"border:1px solid #e3ded3;border-radius:8px;overflow:hidden;background:#fff;\">\n              <div style=\"aspect-ratio:3/2;overflow:hidden;background:#edeae2;\">{{ c.imgEl }}<\u002Fdiv>\n              <div style=\"padding:22px 24px 26px;\">\n                <div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:8px;\">\n                  <span style=\"font-family:'Spectral',serif;font-size:1.5rem;font-weight:700;color:#22574a;\">{{ c.price }}<\u002Fspan>\n                  <span style=\"font-size:13px;color:#8a8577;text-align:right;\">{{ c.location }}<\u002Fspan>\n                <\u002Fdiv>\n                <h3 style=\"font-family:'Spectral',serif;font-weight:600;font-size:1.15rem;line-height:1.3;margin:0 0 12px;color:#17170f;\">{{ c.title }}<\u002Fh3>\n                <div style=\"font-size:14px;color:#5a5a52;border-top:1px solid #efece4;padding:12px 0 0;margin-bottom:14px;\">{{ c.meta }}<\u002Fdiv>\n                {{ c.ctaEl }}\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsection>\n  <\u002Fsc-if>\n\n  <sc-if value=\"{{ isKupujemo }}\" hint-placeholder-val=\"{{ false }}\">\n    <section style=\"padding:32px 24px clamp(64px,8vw,110px);\">\n      <div style=\"max-width:760px;margin:0 auto;\">\n        <a sc-camel-on-click=\"{{ goHome }}\" style=\"display:inline-flex;align-items:center;gap:6px;font-size:15px;font-weight:600;cursor:pointer;margin-bottom:24px;\">‹ Nazad na početnu<\u002Fa>\n        <h1 style=\"font-family:'Spectral',serif;font-weight:700;font-size:clamp(1.9rem,3.6vw,2.9rem);line-height:1.1;margin:0 0 14px;color:#17170f;\">Kupujemo vaš stan<\u002Fh1>\n        <p style=\"margin:0 0 clamp(28px,4vw,40px);color:#45453f;max-width:60ch;\">Prodajete stan u Nišu? Otkupljujemo stanove raznih struktura, na svim lokacijama. Popunite par polja i javimo se sa procenom, bez obaveze.<\u002Fp>\n        <form action=\"mailto:info@deltanekretnine.rs\" method=\"post\" enctype=\"text/plain\" style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;\">\n          <label style=\"display:flex;flex-direction:column;gap:6px;font-size:14px;color:#45453f;\">Ime i prezime\n            <input type=\"text\" name=\"ime\" style=\"font-family:inherit;font-size:16px;padding:12px 14px;border:1px solid #cfc8bb;border-radius:7px;background:#fff;color:#1c1c1a;\">\n          <\u002Flabel>\n          <label style=\"display:flex;flex-direction:column;gap:6px;font-size:14px;color:#45453f;\">Telefon\n            <input type=\"tel\" name=\"telefon\" style=\"font-family:inherit;font-size:16px;padding:12px 14px;border:1px solid #cfc8bb;border-radius:7px;background:#fff;color:#1c1c1a;\">\n          <\u002Flabel>\n          <label style=\"display:flex;flex-direction:column;gap:6px;font-size:14px;color:#45453f;\">Deo grada\n            <input type=\"text\" name=\"lokacija\" placeholder=\"npr. Palilula\" style=\"font-family:inherit;font-size:16px;padding:12px 14px;border:1px solid #cfc8bb;border-radius:7px;background:#fff;color:#1c1c1a;\">\n          <\u002Flabel>\n          <label style=\"display:flex;flex-direction:column;gap:6px;font-size:14px;color:#45453f;\">Struktura\n            <sc-raw-select name=\"struktura\" style=\"font-family:inherit;font-size:16px;padding:12px 14px;border:1px solid #cfc8bb;border-radius:7px;background:#fff;color:#1c1c1a;\">\n              <option>Garsonjera<\u002Foption>\n              <option>Jednosoban<\u002Foption>\n              <option>Jednoiposoban<\u002Foption>\n              <option>Dvosoban<\u002Foption>\n              <option>Dvoiposoban<\u002Foption>\n              <option>Trosoban<\u002Foption>\n              <option>Četvorosoban i veći<\u002Foption>\n            <\u002Fsc-raw-select>\n          <\u002Flabel>\n          <label style=\"display:flex;flex-direction:column;gap:6px;font-size:14px;color:#45453f;\">Kvadratura (m²)\n            <input type=\"number\" name=\"kvadratura\" min=\"0\" style=\"font-family:inherit;font-size:16px;padding:12px 14px;border:1px solid #cfc8bb;border-radius:7px;background:#fff;color:#1c1c1a;\">\n          <\u002Flabel>\n          <label style=\"display:flex;flex-direction:column;gap:6px;font-size:14px;color:#45453f;\">Očekivana cena (€)\n            <input type=\"number\" name=\"cena\" min=\"0\" style=\"font-family:inherit;font-size:16px;padding:12px 14px;border:1px solid #cfc8bb;border-radius:7px;background:#fff;color:#1c1c1a;\">\n          <\u002Flabel>\n          <label style=\"display:flex;flex-direction:column;gap:6px;font-size:14px;color:#45453f;grid-column:1/-1;\">Poruka (opciono)\n            <textarea name=\"poruka\" rows=\"4\" placeholder=\"Sprat, stanje stana, kada prodajete...\" style=\"font-family:inherit;font-size:16px;padding:12px 14px;border:1px solid #cfc8bb;border-radius:7px;background:#fff;color:#1c1c1a;resize:vertical;\"><\u002Ftextarea>\n          <\u002Flabel>\n          <button type=\"submit\" style=\"grid-column:1/-1;justify-self:start;background:#22574a;color:#fff;border:none;padding:14px 28px;border-radius:7px;font-family:inherit;font-weight:600;font-size:16px;cursor:pointer;\">Pošaljite ponudu<\u002Fbutton>\n        <\u002Fform>\n        <p style=\"margin:22px 0 0;font-size:15px;color:#5a5a52;\">Ili pozovite direktno: <a href=\"tel:0649555579\" style=\"font-weight:600;\">064/955 55 79<\u002Fa><\u002Fp>\n      <\u002Fdiv>\n    <\u002Fsection>\n  <\u002Fsc-if>\n\n  <sc-if value=\"{{ isHome }}\" hint-placeholder-val=\"{{ true }}\">\n  <!-- HERO -->\n  <section style=\"padding:clamp(64px,8vw,112px) 24px clamp(56px,7vw,96px);\">\n    <div style=\"max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:clamp(32px,5vw,64px);align-items:stretch;\">\n      <div>\n        <p style=\"margin:0 0 20px;font-size:14px;letter-spacing:0.08em;text-transform:uppercase;color:#22574a;font-weight:600;\">Agencija za nekretnine, Niš<\u002Fp>\n        <h1 style=\"font-family:'Spectral',serif;font-weight:700;font-size:clamp(2.6rem,6vw,4.4rem);line-height:1.04;letter-spacing:-0.02em;margin:0 0 24px;color:#17170f;\">Stan u Nišu, bez lutanja i izgubljenih meseci.<\u002Fh1>\n        <p style=\"margin:0 0 32px;max-width:52ch;font-size:clamp(1.05rem,1.4vw,1.2rem);color:#45453f;\">Pokažemo vam stanove koji stvarno odgovaraju tome šta tražite i koliko možete da date. Provedemo vas kroz pregovore, ugovor, overu i prenos novca, pa budemo tu dok ne uzmete ključeve.<\u002Fp>\n        <div style=\"display:flex;gap:14px;flex-wrap:wrap;\">\n          <a href=\"#kontakt\" style=\"background:#22574a;color:#fff;padding:14px 26px;border-radius:7px;font-weight:600;font-size:16px;\">Pošaljite upit<\u002Fa>\n          <a href=\"#ponuda\" style=\"background:transparent;color:#22574a;padding:14px 26px;border-radius:7px;font-weight:600;font-size:16px;border:1px solid #c9c2b4;\">Pogledajte ponudu<\u002Fa>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"border-radius:8px;overflow:hidden;width:100%;aspect-ratio:1145/1374;box-shadow:none;align-self:center;\">\n        <img src=\"78cca5a1-b9a1-40ed-8ee9-d9f6cf09a09f\" alt=\"Delta Planet, novi stanovi u Nišu\" style=\"width:100%;height:100%;object-fit:cover;display:block;\">\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <!-- USLUGE -->\n  <section id=\"usluge\" style=\"padding:clamp(72px,10vw,128px) 24px;\">\n    <div style=\"max-width:1100px;margin:0 auto;\">\n      <div style=\"max-width:60ch;margin-bottom:clamp(40px,5vw,64px);\">\n        <p style=\"margin:0 0 14px;font-size:14px;letter-spacing:0.08em;text-transform:uppercase;color:#22574a;font-weight:600;\">Šta radimo<\u002Fp>\n        <h2 style=\"font-family:'Spectral',serif;font-weight:700;font-size:clamp(1.9rem,3.4vw,2.8rem);line-height:1.1;letter-spacing:-0.01em;margin:0;color:#17170f;\">Kupovina, prodaja i izdavanje, u Nišu i okolini.<\u002Fh2>\n      <\u002Fdiv>\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:0;border:1px solid #e3ded3;border-radius:8px;overflow:hidden;\">\n        <sc-for list=\"{{ services }}\" as=\"s\" hint-placeholder-count=\"4\">\n          <div sc-camel-on-click=\"{{ s.go }}\" style=\"padding:32px;border-right:1px solid #e3ded3;border-bottom:1px solid #e3ded3;cursor:pointer;\" style-hover=\"background:#f6f4ef;\">\n            <span style=\"width:10px;height:10px;background:#22574a;transform:rotate(45deg);display:inline-block;margin-bottom:18px;\"><\u002Fspan>\n            <h3 style=\"font-family:'Spectral',serif;font-weight:600;font-size:1.35rem;margin:0 0 10px;color:#17170f;\">{{ s.title }}<\u002Fh3>\n            <p style=\"margin:0 0 16px;font-size:15px;color:#555;line-height:1.6;\">{{ s.body }}<\u002Fp>\n            <span style=\"font-size:14px;font-weight:600;color:#22574a;\">{{ s.cta }}<\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fsc-for>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <!-- PONUDA / LISTINGS -->\n  <sc-if value=\"{{ showFeatured }}\" hint-placeholder-val=\"{{ true }}\">\n  <section id=\"ponuda\" style=\"padding:0 24px clamp(72px,10vw,128px);\">\n    <div style=\"max-width:1100px;margin:0 auto;\">\n      <div style=\"display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-bottom:clamp(32px,4vw,48px);\">\n        <div style=\"max-width:52ch;\">\n          <p style=\"margin:0 0 14px;font-size:14px;letter-spacing:0.08em;text-transform:uppercase;color:#22574a;font-weight:600;\">Novo u ponudi<\u002Fp>\n          <h2 style=\"font-family:'Spectral',serif;font-weight:700;font-size:clamp(1.9rem,3.4vw,2.8rem);line-height:1.1;letter-spacing:-0.01em;margin:0;color:#17170f;\">Nekoliko stanova koje sada prodajemo.<\u002Fh2>\n        <\u002Fdiv>\n        <a href=\"#kontakt\" style=\"font-weight:600;font-size:15px;border-bottom:1px solid #22574a;padding-bottom:2px;\">Tražite nešto drugo? Javite nam<\u002Fa>\n      <\u002Fdiv>\n      <div style=\"border:1px solid #e3ded3;border-radius:8px;background:#fff;padding:20px 22px;margin-bottom:28px;display:flex;flex-wrap:wrap;gap:18px 24px;align-items:flex-end;\">\n        <label style=\"display:flex;flex-direction:column;gap:6px;font-size:13px;color:#5a5a52;flex:1 1 180px;\">Lokacija\n          <sc-raw-select sc-camel-on-change=\"{{ onLoc }}\" style=\"font-family:inherit;font-size:15px;padding:10px 12px;border:1px solid #cfc8bb;border-radius:7px;background:#fff;color:#1c1c1a;\">\n            <option value=\"\">Sve lokacije<\u002Foption>\n            <sc-for list=\"{{ filterLocations }}\" as=\"loc\" hint-placeholder-count=\"5\">\n              <option value=\"{{ loc }}\">{{ loc }}<\u002Foption>\n            <\u002Fsc-for>\n          <\u002Fsc-raw-select>\n        <\u002Flabel>\n        <label style=\"display:flex;flex-direction:column;gap:6px;font-size:13px;color:#5a5a52;flex:1 1 200px;\">Cena (€)\n          <div style=\"display:flex;gap:8px;\">\n            <input sc-camel-on-input=\"{{ onMinPrice }}\" type=\"number\" min=\"0\" placeholder=\"od\" style=\"font-family:inherit;font-size:15px;padding:10px 12px;border:1px solid #cfc8bb;border-radius:7px;background:#fff;color:#1c1c1a;width:100%;min-width:0;\">\n            <input sc-camel-on-input=\"{{ onMaxPrice }}\" type=\"number\" min=\"0\" placeholder=\"do\" style=\"font-family:inherit;font-size:15px;padding:10px 12px;border:1px solid #cfc8bb;border-radius:7px;background:#fff;color:#1c1c1a;width:100%;min-width:0;\">\n          <\u002Fdiv>\n        <\u002Flabel>\n        <label style=\"display:flex;flex-direction:column;gap:6px;font-size:13px;color:#5a5a52;flex:1 1 180px;\">Kvadratura (m²)\n          <div style=\"display:flex;gap:8px;\">\n            <input sc-camel-on-input=\"{{ onMinArea }}\" type=\"number\" min=\"0\" placeholder=\"od\" style=\"font-family:inherit;font-size:15px;padding:10px 12px;border:1px solid #cfc8bb;border-radius:7px;background:#fff;color:#1c1c1a;width:100%;min-width:0;\">\n            <input sc-camel-on-input=\"{{ onMaxArea }}\" type=\"number\" min=\"0\" placeholder=\"do\" style=\"font-family:inherit;font-size:15px;padding:10px 12px;border:1px solid #cfc8bb;border-radius:7px;background:#fff;color:#1c1c1a;width:100%;min-width:0;\">\n          <\u002Fdiv>\n        <\u002Flabel>\n        <label style=\"display:flex;flex-direction:column;gap:6px;font-size:13px;color:#5a5a52;flex:1 1 190px;\">Sortiranje\n          <sc-raw-select sc-camel-on-change=\"{{ onSort }}\" style=\"font-family:inherit;font-size:15px;padding:10px 12px;border:1px solid #cfc8bb;border-radius:7px;background:#fff;color:#1c1c1a;\">\n            <option value=\"rec\">Preporučeno<\u002Foption>\n            <option value=\"priceAsc\">Cena: od najniže<\u002Foption>\n            <option value=\"priceDesc\">Cena: od najviše<\u002Foption>\n            <option value=\"areaDesc\">Kvadratura: veća prvo<\u002Foption>\n            <option value=\"areaAsc\">Kvadratura: manja prvo<\u002Foption>\n          <\u002Fsc-raw-select>\n        <\u002Flabel>\n        <button sc-camel-on-click=\"{{ resetFilters }}\" style=\"font-family:inherit;font-size:14px;font-weight:600;color:#22574a;background:transparent;border:1px solid #c9c2b4;border-radius:7px;padding:10px 16px;cursor:pointer;\">Poništi<\u002Fbutton>\n      <\u002Fdiv>\n      <p style=\"margin:0 0 20px;font-size:14px;color:#5a5a52;\">{{ resultCount }} stanova u ponudi<\u002Fp>\n      <sc-if value=\"{{ noResults }}\" hint-placeholder-val=\"{{ false }}\">\n        <p style=\"margin:0 0 24px;color:#5a5a52;\">Nema stanova koji odgovaraju filterima. Promenite kriterijume ili poništite filtere.<\u002Fp>\n      <\u002Fsc-if>\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:28px;\">\n        <sc-for list=\"{{ listings }}\" as=\"l\" hint-placeholder-count=\"4\">\n          <div style=\"border:1px solid #e3ded3;border-radius:8px;overflow:hidden;background:#fff;\">\n            <div sc-camel-on-click=\"{{ l.open }}\" style=\"position:relative;aspect-ratio:3/2;cursor:pointer;overflow:hidden;background:#edeae2;\">\n              <img src=\"{{ l.thumb }}\" alt=\"{{ l.title }}\" loading=\"lazy\" style=\"width:100%;height:100%;object-fit:cover;display:block;\">\n              <span style=\"position:absolute;left:12px;bottom:12px;background:rgba(15,15,10,0.74);color:#fff;font-size:12px;letter-spacing:0.03em;padding:6px 11px;border-radius:5px;\">Pogledajte detalje<\u002Fspan>\n            <\u002Fdiv>\n            <div style=\"padding:22px 24px 26px;\">\n              <div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:8px;\">\n                <span style=\"font-family:'Spectral',serif;font-size:1.5rem;font-weight:700;color:#22574a;\">{{ l.price }}<\u002Fspan>\n                <span style=\"font-size:13px;color:#8a8577;\">{{ l.location }}<\u002Fspan>\n              <\u002Fdiv>\n              <h3 style=\"font-family:'Spectral',serif;font-weight:600;font-size:1.15rem;line-height:1.3;margin:0 0 16px;color:#17170f;\">{{ l.title }}<\u002Fh3>\n              <div style=\"font-size:14px;color:#5a5a52;border-top:1px solid #efece4;padding-top:14px;\">{{ l.meta }}<\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fsc-for>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n  <\u002Fsc-if>\n\n  <!-- O NAMA -->\n  <section id=\"onama\" style=\"padding:clamp(72px,10vw,128px) 24px;\">\n    <div style=\"max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:clamp(32px,5vw,64px);align-items:center;\">\n      <div style=\"border:1px solid #e0dbd0;border-radius:8px;overflow:hidden;aspect-ratio:4/5;background:#eceae3;\">\n        <img src=\"https://deltanekretnine.rs/wp-content/uploads/2016/02/Nikola-agent-za-nekretnine-Delta-nekretnine.jpg\" alt=\"Nikola Stojanović, agent za nekretnine\" style=\"width:100%;height:100%;object-fit:cover;display:block;\">\n      <\u002Fdiv>\n      <div style=\"max-width:60ch;\">\n        <p style=\"margin:0 0 14px;font-size:14px;letter-spacing:0.08em;text-transform:uppercase;color:#22574a;font-weight:600;\">O nama<\u002Fp>\n        <h2 style=\"font-family:'Spectral',serif;font-weight:700;font-size:clamp(1.9rem,3.4vw,2.8rem);line-height:1.1;letter-spacing:-0.01em;margin:0 0 24px;color:#17170f;\">Nikola Stojanović, osnivač agencije<\u002Fh2>\n        <p style=\"margin:0 0 18px;color:#45453f;\">Nikola je diplomirani pravnik i licencirani agent za nekretnine, licenca broj 1851. Osnovao je Delta nekretnine posle godina rada na prometu i zakupu stanova u Nišu.<\u002Fp>\n        <p style=\"margin:0 0 18px;color:#45453f;\">Radi po celom Nišu i jugoistočnoj Srbiji. Pošto je pravnik, ugovor, overu i papire drži pod kontrolom, pa vi ne morate da brinete da li je nešto promaklo.<\u002Fp>\n        <p style=\"margin:0;color:#45453f;\">Kancelarija je na Bulevaru Nemanjića 35, u Eurospace-u, lokal 7. Svratite ili pozovite, pa da vidimo šta tražite.<\u002Fp>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <!-- TESTIMONIJALI -->\n  <sc-if value=\"{{ showTestimonials }}\" hint-placeholder-val=\"{{ true }}\">\n  <section style=\"padding:0 24px clamp(72px,10vw,128px);\">\n    <div style=\"max-width:1100px;margin:0 auto;\">\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:28px;\">\n        <sc-for list=\"{{ testimonials }}\" as=\"t\" hint-placeholder-count=\"3\">\n          <figure style=\"margin:0;border:1px solid #e3ded3;border-radius:8px;padding:30px;background:#fff;display:flex;flex-direction:column;\">\n            <blockquote style=\"margin:0 0 20px;font-family:'Spectral',serif;font-size:1.15rem;line-height:1.5;color:#2a2a24;\">{{ t.quote }}<\u002Fblockquote>\n            <figcaption style=\"margin-top:auto;font-size:14px;color:#5a5a52;\">\n              <span style=\"display:block;font-weight:600;color:#17170f;\">{{ t.name }}<\u002Fspan>\n              {{ t.role }}\n            <\u002Ffigcaption>\n          <\u002Ffigure>\n        <\u002Fsc-for>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n  <\u002Fsc-if>\n\n  <!-- KONTAKT / CTA -->\n  <section id=\"kontakt\" style=\"padding:clamp(72px,10vw,128px) 24px;background:#f1efe8;border-top:1px solid #e3ded3;\">\n    <div style=\"max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:clamp(36px,5vw,72px);\">\n      <div style=\"max-width:46ch;\">\n        <h2 style=\"font-family:'Spectral',serif;font-weight:700;font-size:clamp(1.9rem,3.6vw,3rem);line-height:1.08;letter-spacing:-0.01em;margin:0 0 20px;color:#17170f;\">Recite nam šta tražite.<\u002Fh2>\n        <p style=\"margin:0 0 28px;color:#45453f;\">Napišite par reči, deo grada, koliko soba i otprilike koliko možete da date. Javimo se istog dana i pošaljemo šta imamo.<\u002Fp>\n        <div style=\"display:flex;flex-direction:column;gap:12px;font-size:16px;\">\n          <a href=\"tel:0649555579\" style=\"color:#17170f;font-weight:500;\">064/955 55 79<\u002Fa>\n          <a href=\"tel:0649555589\" style=\"color:#17170f;font-weight:500;\">064/955 55 89<\u002Fa>\n          <a href=\"mailto:info@deltanekretnine.rs\" style=\"color:#17170f;font-weight:500;\">info@deltanekretnine.rs<\u002Fa>\n          <span style=\"color:#5a5a52;\">Bulevar Nemanjića 35, Eurospace lokal 7, Niš<\u002Fspan>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <form action=\"mailto:info@deltanekretnine.rs\" method=\"post\" enctype=\"text/plain\" style=\"display:flex;flex-direction:column;gap:16px;\">\n        <label style=\"display:flex;flex-direction:column;gap:6px;font-size:14px;color:#45453f;\">Ime\n          <input type=\"text\" name=\"ime\" style=\"font-family:inherit;font-size:16px;padding:12px 14px;border:1px solid #cfc8bb;border-radius:7px;background:#fff;color:#1c1c1a;\">\n        <\u002Flabel>\n        <label style=\"display:flex;flex-direction:column;gap:6px;font-size:14px;color:#45453f;\">Telefon\n          <input type=\"tel\" name=\"telefon\" style=\"font-family:inherit;font-size:16px;padding:12px 14px;border:1px solid #cfc8bb;border-radius:7px;background:#fff;color:#1c1c1a;\">\n        <\u002Flabel>\n        <label style=\"display:flex;flex-direction:column;gap:6px;font-size:14px;color:#45453f;\">Šta tražite\n          <textarea name=\"poruka\" rows=\"4\" style=\"font-family:inherit;font-size:16px;padding:12px 14px;border:1px solid #cfc8bb;border-radius:7px;background:#fff;color:#1c1c1a;resize:vertical;\" placeholder=\"npr. dvosoban, Palilula ili centar, do 130.000 evra\"><\u002Ftextarea>\n        <\u002Flabel>\n        <button type=\"submit\" style=\"background:#22574a;color:#fff;border:none;padding:14px 26px;border-radius:7px;font-family:inherit;font-weight:600;font-size:16px;cursor:pointer;align-self:flex-start;\">Pošaljite upit<\u002Fbutton>\n      <\u002Fform>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <\u002Fsc-if>\n\n  <!-- FOOTER -->\n  <footer style=\"padding:clamp(48px,6vw,72px) 24px 40px;background:#17170f;color:#b9b6ab;\">\n    <div style=\"max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:40px;\">\n      <div>\n        <a href=\"#top\" style=\"display:inline-flex;margin-bottom:16px;\">\n          <img src=\"https://deltanekretnine.rs/wp-content/uploads/2020/11/logo-light-50.png\" alt=\"Delta nekretnine\" style=\"height:40px;width:auto;display:block;\">\n        <\u002Fa>\n        <p style=\"margin:0;font-size:14px;max-width:32ch;\">Agencija za prodaju, izdavanje i novogradnju u Nišu.<\u002Fp>\n      <\u002Fdiv>\n      <div>\n        <p style=\"margin:0 0 12px;color:#fff;font-weight:600;font-size:14px;\">Ponuda<\u002Fp>\n        <div style=\"display:flex;flex-direction:column;gap:8px;font-size:14px;\">\n          <a href=\"#ponuda\" style=\"color:#b9b6ab;\">Stanovi na prodaju<\u002Fa>\n          <a href=\"#ponuda\" style=\"color:#b9b6ab;\">Izdavanje<\u002Fa>\n          <a href=\"#ponuda\" style=\"color:#b9b6ab;\">Novogradnja<\u002Fa>\n          <a href=\"#usluge\" style=\"color:#b9b6ab;\">Kuće i lokali<\u002Fa>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div>\n        <p style=\"margin:0 0 12px;color:#fff;font-weight:600;font-size:14px;\">Kontakt<\u002Fp>\n        <div style=\"display:flex;flex-direction:column;gap:8px;font-size:14px;\">\n          <a href=\"tel:0649555579\" style=\"color:#b9b6ab;\">064/955 55 79<\u002Fa>\n          <a href=\"tel:0649555589\" style=\"color:#b9b6ab;\">064/955 55 89<\u002Fa>\n          <a href=\"mailto:info@deltanekretnine.rs\" style=\"color:#b9b6ab;\">info@deltanekretnine.rs<\u002Fa>\n          <span>Bulevar Nemanjića 35, Niš<\u002Fspan>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <div style=\"max-width:1100px;margin:40px auto 0;padding-top:24px;border-top:1px solid #39392f;font-size:13px;color:#86857b;\">© 2026 Delta nekretnine, Niš<\u002Fdiv>\n  <\u002Ffooter>\n\n  <sc-if value=\"{{ galleryOpen }}\" hint-placeholder-val=\"{{ false }}\">\n    <div sc-camel-on-click=\"{{ closeGallery }}\" style=\"position:fixed;inset:0;z-index:100;background:rgba(15,15,10,0.93);display:flex;flex-direction:column;padding:20px 20px 28px;\">\n      <div style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;max-width:1100px;width:100%;margin:0 auto 16px;\">\n        <div style=\"min-width:0;\">\n          <p style=\"margin:0;font-family:'Spectral',serif;font-size:1.15rem;color:#fff;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">{{ galleryTitle }}<\u002Fp>\n          <p style=\"margin:2px 0 0;font-size:13px;color:#b9b6ab;\">{{ galleryCounter }}<\u002Fp>\n        <\u002Fdiv>\n        <button sc-camel-on-click=\"{{ closeGallery }}\" style=\"flex-shrink:0;background:transparent;border:1px solid #5a5a4e;color:#f1efe8;font-family:inherit;font-size:14px;padding:9px 16px;border-radius:6px;cursor:pointer;\">Zatvori<\u002Fbutton>\n      <\u002Fdiv>\n      <div style=\"flex:1;display:flex;align-items:center;justify-content:center;gap:14px;min-height:0;\">\n        <button sc-camel-on-click=\"{{ prevImage }}\" style=\"flex-shrink:0;width:48px;height:48px;border-radius:50%;border:1px solid #5a5a4e;background:rgba(0,0,0,0.3);color:#fff;font-size:24px;line-height:1;cursor:pointer;\">‹<\u002Fbutton>\n        {{ galleryImg }}\n        <button sc-camel-on-click=\"{{ nextImage }}\" style=\"flex-shrink:0;width:48px;height:48px;border-radius:50%;border:1px solid #5a5a4e;background:rgba(0,0,0,0.3);color:#fff;font-size:24px;line-height:1;cursor:pointer;\">›<\u002Fbutton>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsc-if>\n\n<\u002Fdiv>\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;$preview&quot;:{&quot;width&quot;:&quot;100%&quot;},&quot;showFeatured&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Sekcije&quot;},&quot;showTestimonials&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Sekcije&quot;}}\">\nclass Component extends DCLogic {\n  state = { galleryOpen: false, li: 0, img: 0, view: \"home\", di: 0, cat: \"\", fLoc: \"\", fMinPrice: \"\", fMaxPrice: \"\", fMinArea: \"\", fMaxArea: \"\", fSort: \"rec\" };\n  setFilter(k, v) { this.setState({ [k]: v }); }\n  toggleMenu() { this.setState(s => ({ menuOpen: !s.menuOpen })); }\n  closeMenu() { this.setState({ menuOpen: false }); }\n  goCat(c) { this.setState({ view: \"cat\", cat: c }); window.scrollTo(0, 0); }\n  goKupujemo() { this.setState({ view: \"kupujemo\" }); window.scrollTo(0, 0); }\n  componentDidMount() {\n    this._key = (e) => {\n      if (!this.state.galleryOpen) return;\n      if (e.key === \"Escape\") this.closeGallery();\n      else if (e.key === \"ArrowRight\") this.nextImage();\n      else if (e.key === \"ArrowLeft\") this.prevImage();\n    };\n    document.addEventListener(\"keydown\", this._key);\n  }\n  componentWillUnmount() { document.removeEventListener(\"keydown\", this._key); }\n  openGallery(li, img) { this.setState({ galleryOpen: true, li: li, img: img || 0 }); }\n  goDetail(i) { this.setState({ view: \"detail\", di: i }); window.scrollTo(0, 0); }\n  goHome() { this.setState({ view: \"home\" }); window.scrollTo(0, 0); }\n  closeGallery() { this.setState({ galleryOpen: false }); }\n  nextImage(e) { if (e && e.stopPropagation) e.stopPropagation(); const n = this._data[this.state.li].images.length; this.setState(s => ({ img: (s.img + 1) % n })); }\n  prevImage(e) { if (e && e.stopPropagation) e.stopPropagation(); const n = this._data[this.state.li].images.length; this.setState(s => ({ img: (s.img - 1 + n) % n })); }\n  get _data() {\n    return [\n      {\n        price: \"133.500€\", location: \"Strogi centar\", title: \"Komforan stan u strogom centru\",\n        meta: \"70 m² · 3 sobe · 2. sprat · centralno grejanje\",\n        images: [\"https://deltanekretnine.rs/wp-content/uploads/2026/09/WhatsApp-Image-2026-09-15-at-13.37.50-5-Copy-1024x768.jpeg\"],\n        map: \"Strogi centar, Niš\",\n        paras: [\n          \"Funkcionalan dvosoban stan u strogom centru grada, površine 70 m² (grejna površina 58 m²), sa dve prostrane terase. Nalazi se na drugom spratu zgrade bez lifta, u blizini TC Forum i pešačke zone.\",\n          \"Čine ga ulazni hodnik, dnevni boravak, trpezarija sa kuhinjom, spavaća soba, dve terase i kupatilo. Grejanje je centralno. Lako se preuređuje u dvoiposoban, premeštanjem kuhinje u dnevni boravak.\",\n          \"Upisan u katastar kao vlasništvo 1/1, zgrada ima upotrebnu dozvolu. Kupcu obezbeđujemo pravnu podršku i prisustvo kod overe ugovora kod notara. Provizija za kupce je 1%.\"\n        ],\n        rows: [\n          { label: \"ID oglasa\", value: \"D135\" }, { label: \"Površina\", value: \"70 m²\" },\n          { label: \"Sobe\", value: \"3\" }, { label: \"Kupatilo\", value: \"1\" },\n          { label: \"Sprat\", value: \"2\" }, { label: \"Grejanje\", value: \"Centralno\" }\n        ],\n        features: [\"Klima\", \"Parket\", \"Podrum\", \"Terasa\"]\n      },\n      {\n        price: \"110.000€\", location: \"Čair\", title: \"Jednoiposoban stan u Čairu, nadomak parka\",\n        meta: \"39 m² · 2 sobe · 5. sprat · lift i parking\",\n        images: [\"https://deltanekretnine.rs/wp-content/uploads/2026/09/WhatsApp-Image-2026-09-10-at-08.25.23-7-Copy-1024x768.jpeg\"],\n        map: \"Čair, Niš\",\n        paras: [\n          \"Jednoiposoban stan od 39 m² nadomak parka Čair, na petom spratu (ne i poslednjem) zgrade novije gradnje sa liftom, u jednom od najtraženijih delova grada.\",\n          \"Raspored: ulazni hodnik, dnevni boravak sa trpezarijom i kuhinjom, spavaća soba, prostrana terasa i kupatilo. Grejanje je centralno, uz parking mesto u dvorištu zgrade.\",\n          \"U blizini su park Čair, Dom zdravlja, pijaca, škola, banke i prodavnice. Stan je uknjižen 1/1, bez tereta, zgrada ima upotrebnu dozvolu. Provizija za kupce je 1%.\"\n        ],\n        rows: [\n          { label: \"ID oglasa\", value: \"D128\" }, { label: \"Površina\", value: \"39 m²\" },\n          { label: \"Sobe\", value: \"2\" }, { label: \"Kupatilo\", value: \"1\" },\n          { label: \"Sprat\", value: \"5\" }, { label: \"Grejanje\", value: \"Centralno\" }\n        ],\n        features: [\"Klima\", \"Lift\", \"Novija gradnja\", \"Parket\", \"Parking u dvorištu zgrade\", \"PVC stolarija\", \"Terasa\"]\n      },\n      {\n        price: \"81.600€\", location: \"Palilula\", title: \"Komforan dvosoban stan na Paliluli\",\n        meta: \"48 m² · 2 sobe · 4. sprat · parking oko zgrade\",\n        images: [\"https://deltanekretnine.rs/wp-content/uploads/2026/09/WhatsApp-Image-2026-09-18-at-20.01.00-4-Copy-1024x768.jpeg\"],\n        map: \"Palilula, Niš\",\n        paras: [\n          \"Dvosoban stan od 48 m² u Božidarčevoj ulici na Paliluli, na četvrtom spratu zgrade bez lifta. Miran i bezbedan kraj, dobro povezan sa ostatkom grada.\",\n          \"Čine ga ulazni hodnik, dnevni boravak, odvojena kuhinja sa trpezarijom, spavaća soba, kupatilo i terasa. Grejanje je na struju, parking ima oko zgrade i u dvorištu.\",\n          \"Upisan kao vlasništvo 1/1. Kupcu obezbeđujemo pravnu podršku i prisustvo kod overe ugovora kod notara. Provizija za kupce je 1%.\"\n        ],\n        rows: [\n          { label: \"ID oglasa\", value: \"D137\" }, { label: \"Površina\", value: \"48 m²\" },\n          { label: \"Sobe\", value: \"2\" }, { label: \"Kupatilo\", value: \"1\" },\n          { label: \"Sprat\", value: \"4\" }, { label: \"Grejanje\", value: \"Na struju\" }\n        ],\n        features: [\"Javni parking van zone\", \"Parking u dvorištu zgrade\", \"PVC stolarija\", \"Terasa\"]\n      },\n      {\n        price: \"209.000€\", location: \"Crveni pevac\", title: \"Komforan troiposoban stan, bez ulaganja\",\n        meta: \"111 m² · dupleks · 5. sprat · lift i podrum\",\n        images: [\"https://deltanekretnine.rs/wp-content/uploads/2026/08/WhatsApp-Image-2026-08-21-at-13.49.10-4-Copy-1024x768.jpeg\"],\n        map: \"Crveni pevac, Niš\",\n        paras: [\n          \"Komforan troiposoban dupleks od 111 m², između centra grada i Bulevara Nemanjića, na petom spratu zgrade novije gradnje sa liftom.\",\n          \"Prostire se na dve etaže: dnevni boravak, trpezarija, kuhinja, dve spavaće sobe, galerija (može i kao treća soba), ostava-garderoba, kupatilo i toalet, uz prostranu terasu. Grejanje je centralno sa kalorimetrima, uz pripadajuću podrumsku prostoriju.\",\n          \"U blizini su škole, vrtići, park i tržni centri. Upisan 1/1. Kupcu obezbeđujemo pravnu podršku i prisustvo kod overe ugovora kod notara.\"\n        ],\n        rows: [\n          { label: \"ID oglasa\", value: \"D112\" }, { label: \"Površina\", value: \"111 m²\" },\n          { label: \"Sobe\", value: \"3\" }, { label: \"Kupatila\", value: \"2\" },\n          { label: \"Sprat\", value: \"5\" }, { label: \"Grejanje\", value: \"Centralno\" }\n        ],\n        features: [\"Bez ulaganja\", \"Klima\", \"Lift\", \"Mašina za pranje veša\", \"Novija gradnja\", \"Ostava\", \"Parket\", \"Podrum\", \"Terasa\"]\n      },\n      {\n        price: \"165.000€\", location: \"Crveni pevac\", title: \"Prostran trosoban stan na Crvenom pevcu\",\n        meta: \"79,5 m² · 3 sobe · 9. sprat · lift i parking\",\n        images: [\"https://deltanekretnine.rs/wp-content/uploads/2026/08/viber_image_2026-08-31_10-01-49-290-Copy-1024x768.jpg\"],\n        map: \"Crveni pevac, Niš\",\n        paras: [\n          \"Prostran trosoban stan od 79,5 m² (grejna površina 72 m²) na Crvenom pevcu, na devetom spratu (ne i poslednjem) kvalitetno građene zgrade.\",\n          \"Raspored: ulazni hodnik, dnevni boravak, trpezarija sa kuhinjom, dve spavaće sobe, prostrana terasa i kupatilo. Grejanje je centralno, uz obezbeđeno parking mesto i podrumsku prostoriju.\",\n          \"U krugu od 300 m su škola, vrtić, park Svetog Save, Dom zdravlja i Delta planet. Uknjižen 1/1, bez tereta. Provizija za kupce je 1%.\"\n        ],\n        rows: [\n          { label: \"ID oglasa\", value: \"D117\" }, { label: \"Površina\", value: \"79,5 m²\" },\n          { label: \"Sobe\", value: \"3\" }, { label: \"Kupatilo\", value: \"1\" },\n          { label: \"Sprat\", value: \"9\" }, { label: \"Grejanje\", value: \"Centralno\" }\n        ],\n        features: [\"Javni parking van zone\", \"Kablovska TV\", \"Klima\", \"Lift\", \"Parket\", \"Parking u dvorištu zgrade\", \"Terasa\"]\n      },\n      {\n        price: \"99.700€\", location: \"Centar, Marger\", title: \"Opremljen jednoiposoban stan u centru\",\n        meta: \"44 m² · 2 sobe · 4. sprat · lift, namešten\",\n        images: [\"https://deltanekretnine.rs/wp-content/uploads/2026/07/WhatsApp-Image-2026-07-07-at-08.38.45-Copy-1024x768.jpeg\"],\n        map: \"Saborna crkva, Niš\",\n        paras: [\n          \"Opremljen jednoiposoban stan od 44 m² u strogom centru, nadomak Saborne crkve, na četvrtom spratu zgrade sa liftom.\",\n          \"Čine ga ulazni hodnik, dnevni boravak sa trpezarijom i kuhinjom, spavaća soba i kupatilo. Grejanje je centralno, uz klimu. Prodaje se namešten, ključ u ruke, spreman za useljenje.\",\n          \"Manji stanovi u centru se retko prodaju, pa je ovo i dobra investicija za izdavanje. Upisan 1/1. Provizija za kupce je 1%.\"\n        ],\n        rows: [\n          { label: \"ID oglasa\", value: \"D989\" }, { label: \"Površina\", value: \"44 m²\" },\n          { label: \"Sobe\", value: \"2\" }, { label: \"Kupatilo\", value: \"1\" },\n          { label: \"Sprat\", value: \"4\" }, { label: \"Grejanje\", value: \"Centralno\" }\n        ],\n        features: [\"Bez ulaganja\", \"Internet\", \"Kablovska TV\", \"Klima\", \"Lift\", \"Parket\"]\n      }\n    ];\n  }\n  get _rentals() {\n    return [\n      { price: \"400€\", location: \"Delta Planet, Bulevar Nemanjića\", title: \"Moderan stan u novoj zgradi, blizu Delte\", meta: \"54 m² · nova zgradnja\" },\n      { price: \"600€\", location: \"Palilula, Čair\", title: \"Luksuzan dvosoban stan sa parkingom, u novoj zgradi\", meta: \"49 m² · 4. sprat · parking i lift\", images: [\"https://deltanekretnine.rs/wp-content/uploads/2026/10/WhatsApp-Image-2026-10-04-at-12.10.56-Copy-1024x768.jpeg\"] },\n      { price: \"550€\", location: \"Centar\", title: \"Luksuzan stan u novoj zgradi u centru\", meta: \"55 m² · nova zgradnja\" },\n      { price: \"350€\", location: \"Bulevar Nemanjića\", title: \"Prostran dvosoban stan na Bulevaru Nemanjića\", meta: \"53 m² · 7. sprat · namešten, lift\", images: [\"https://deltanekretnine.rs/wp-content/uploads/2026/09/WhatsApp-Image-2026-09-21-at-23.45.53-1-Copy-1024x768.jpeg\"] },\n      { price: \"450€\", location: \"Strogi centar\", title: \"Luksuzan dvosoban stan u strogom centru\", meta: \"60 m² · dvosoban\" },\n      { price: \"400€\", location: \"Centar\", title: \"Moderan stan u novoj zgradi u centru\", meta: \"55 m² · nova zgradnja\" }\n    ];\n  }\n  get _novogradnja() {\n    return [\n      { price: \"135.000€\", location: \"Palilula\", title: \"Trosoban stan u novogradnji, na Paliluli\", meta: \"67 m² · 3 sobe\" },\n      { price: \"147.000€\", location: \"Vojna bolnica, Klinički centar\", title: \"Prostran trosoban stan sa parkingom, u novijoj zgradi\", meta: \"70 m² · 3 sobe · parking\" },\n      { price: \"165.600€\", location: \"Delta Planet, Bulevar Nemanjića\", title: \"Luksuzna novogradnja blizu Delta Planeta\", meta: \"55,20 m² · novogradnja\" },\n      { price: \"245.000€\", location: \"Bulevar Nemanjića, Planet Residence\", title: \"Planet Residence, trosoban stan sa garažnim mestom\", meta: \"80 m² · garaža\" },\n      { price: \"209.950€\", location: \"Pantelej\", title: \"Opremljen četvorosoban stan, povraćaj PDV-a\", meta: \"199 m² · 4 sobe\" },\n      { price: \"295.000€\", location: \"Bulevar Nemanjića, Park Svetog Save\", title: \"Četvorosoban stan u novoj zgradi na prestižnoj lokaciji\", meta: \"107 m² · 4 sobe\" }\n    ];\n  }\n  renderVals() {\n    const num = (s) => parseFloat(String(s).replace(/\\./g, \"\").replace(\",\", \".\").replace(/[^0-9.]/g, \"\")) || 0;\n    const areaOf = (l) => { const r = (l.rows || []).find(x => x.label === \"Površina\"); return r ? num(r.value) : 0; };\n    const st = this.state;\n    const locations = Array.from(new Set(this._data.map(l => l.location)));\n    let items = this._data.map((l, i) => ({ ...l, i, thumb: l.images[0], count: l.images.length, priceNum: num(l.price), areaNum: areaOf(l), open: () => this.goDetail(i) }));\n    items = items.filter(l => {\n      if (st.fLoc && l.location !== st.fLoc) return false;\n      if (st.fMinPrice && l.priceNum < num(st.fMinPrice)) return false;\n      if (st.fMaxPrice && l.priceNum > num(st.fMaxPrice)) return false;\n      if (st.fMinArea && l.areaNum < num(st.fMinArea)) return false;\n      if (st.fMaxArea && l.areaNum > num(st.fMaxArea)) return false;\n      return true;\n    });\n    const sorters = {\n      priceAsc: (a, b) => a.priceNum - b.priceNum,\n      priceDesc: (a, b) => b.priceNum - a.priceNum,\n      areaAsc: (a, b) => a.areaNum - b.areaNum,\n      areaDesc: (a, b) => b.areaNum - a.areaNum\n    };\n    if (sorters[st.fSort]) items.sort(sorters[st.fSort]);\n    const listings = items;\n    const R = React.createElement;\n    const ph = () => R(\"div\", { style: { width: \"100%\", height: \"100%\", backgroundImage: \"repeating-linear-gradient(135deg,#edeae2 0 14px,#e5e1d6 14px 28px)\", display: \"flex\", alignItems: \"center\", justifyContent: \"center\" } }, R(\"span\", { style: { fontFamily: \"monospace\", fontSize: \"12px\", letterSpacing: \"0.1em\", color: \"#8a8577\", textTransform: \"uppercase\" } }, \"Fotografija stana\"));\n    const mkItems = (arr, sale) => arr.map((l) => {\n      const open = sale ? (() => this.goDetail(this._data.indexOf(l))) : null;\n      const imgEl = (l.images && l.images[0])\n        ? R(\"img\", { src: l.images[0], alt: l.title, loading: \"lazy\", onClick: open || undefined, style: { width: \"100%\", height: \"100%\", objectFit: \"cover\", display: \"block\", cursor: sale ? \"pointer\" : \"default\" } })\n        : ph();\n      const ctaEl = sale\n        ? R(\"span\", { onClick: open, style: { fontWeight: 600, fontSize: \"14px\", color: \"#22574a\", cursor: \"pointer\", borderBottom: \"1px solid #22574a\", paddingBottom: \"2px\" } }, \"Pogledajte detalje ›\")\n        : R(\"a\", { href: \"tel:0649555579\", style: { fontWeight: 600, fontSize: \"14px\", color: \"#22574a\", borderBottom: \"1px solid #22574a\", paddingBottom: \"2px\" } }, \"Pozovite za obilazak ›\");\n      return { price: l.price, location: l.location, title: l.title, meta: l.meta, imgEl, ctaEl };\n    });\n    let catItems = [], catTitle = \"\", catSub = \"\";\n    if (st.view === \"cat\") {\n      if (st.cat === \"prodaja\") { catTitle = \"Stanovi na prodaju\"; catSub = \"Svi stanovi koje trenutno prodajemo u Nišu.\"; catItems = mkItems(this._data, true); }\n      else if (st.cat === \"izdavanje\") { catTitle = \"Izdavanje\"; catSub = \"Stanovi za iznajmljivanje. Za zakupce je naša usluga besplatna.\"; catItems = mkItems(this._rentals, false); }\n      else if (st.cat === \"novogradnja\") { catTitle = \"Novogradnja\"; catSub = \"Stanovi u novim i novijim zgradama, uknjiženi i useljivi.\"; catItems = mkItems(this._novogradnja, false); }\n    }\n    const cur = this._data[this.state.li] || { images: [], title: \"\" };\n    const d = this._data[this.state.di] || { images: [], paras: [], rows: [], features: [] };\n    const thumbStyle = { width: \"88px\", height: \"66px\", objectFit: \"cover\", borderRadius: \"6px\", cursor: \"pointer\", border: \"1px solid #e3ded3\", display: \"block\" };\n    return {\n      showFeatured: this.props.showFeatured ?? true,\n      showTestimonials: this.props.showTestimonials ?? true,\n      listings,\n      resultCount: listings.length,\n      noResults: listings.length === 0,\n      filterLocations: locations,\n      onLoc: (e) => this.setFilter(\"fLoc\", e.target.value),\n      onMinPrice: (e) => this.setFilter(\"fMinPrice\", e.target.value),\n      onMaxPrice: (e) => this.setFilter(\"fMaxPrice\", e.target.value),\n      onMinArea: (e) => this.setFilter(\"fMinArea\", e.target.value),\n      onMaxArea: (e) => this.setFilter(\"fMaxArea\", e.target.value),\n      onSort: (e) => this.setFilter(\"fSort\", e.target.value),\n      resetFilters: () => this.setState({ fLoc: \"\", fMinPrice: \"\", fMaxPrice: \"\", fMinArea: \"\", fMaxArea: \"\", fSort: \"rec\" }),\n      isHome: this.state.view === \"home\",\n      isDetail: this.state.view === \"detail\",\n      isCat: this.state.view === \"cat\",\n      isKupujemo: this.state.view === \"kupujemo\",\n      catTitle, catSub, catItems,\n      goHome: () => this.goHome(),\n      menuOpen: this.state.menuOpen,\n      toggleMenu: () => this.toggleMenu(),\n      closeMenu: () => this.closeMenu(),\n      detailTitle: d.title,\n      detailPrice: d.price,\n      detailLocation: d.location,\n      detailParas: d.paras,\n      detailRows: d.rows,\n      detailFeatures: d.features,\n      detailMapLabel: d.map,\n      detailMap: (this.state.view === \"detail\" && d.map) ? React.createElement(\"div\", null,\n        React.createElement(\"iframe\", {\n          src: \"https://www.google.com/maps?q=\" + encodeURIComponent(d.map) + \"&output=embed\",\n          title: \"Lokacija: \" + d.map, loading: \"lazy\",\n          style: { width: \"100%\", height: \"340px\", border: \"1px solid #e3ded3\", borderRadius: \"8px\", display: \"block\" }\n        }),\n        React.createElement(\"a\", {\n          href: \"https://www.google.com/maps/search/?api=1&query=\" + encodeURIComponent(d.map),\n          target: \"_blank\", rel: \"noopener noreferrer\",\n          style: { display: \"inline-block\", marginTop: \"12px\", fontWeight: 600, fontSize: \"15px\", color: \"#22574a\", borderBottom: \"1px solid #22574a\", paddingBottom: \"2px\" }\n        }, \"Otvorite u Google mapama ↗\")\n      ) : null,\n      detailMainImg: this.state.view === \"detail\" ? React.createElement(\"img\", {\n        src: d.images[0], alt: d.title, onClick: () => this.openGallery(this.state.di, 0),\n        style: { width: \"100%\", aspectRatio: \"16/10\", objectFit: \"cover\", borderRadius: \"8px\", cursor: \"pointer\", display: \"block\", border: \"1px solid #e3ded3\" }\n      }) : null,\n      detailThumbs: (this.state.view === \"detail\" && d.images.length > 1) ? React.createElement(\"div\",\n        { style: { display: \"flex\", gap: \"10px\", flexWrap: \"wrap\", marginTop: \"12px\" } },\n        d.images.map((src, idx) => React.createElement(\"img\", { key: idx, src: src, alt: d.title, onClick: () => this.openGallery(this.state.di, idx), style: thumbStyle }))\n      ) : null,\n      galleryOpen: this.state.galleryOpen,\n      galleryImg: this.state.galleryOpen ? React.createElement(\"img\", {\n        src: cur.images[this.state.img],\n        alt: cur.title,\n        onClick: (e) => this.nextImage(e),\n        style: { maxWidth: \"min(1100px, calc(100% - 140px))\", maxHeight: \"100%\", objectFit: \"contain\", borderRadius: \"8px\", cursor: \"pointer\", display: \"block\" }\n      }) : null,\n      galleryTitle: cur.title,\n      galleryCounter: (this.state.img + 1) + \" / \" + cur.images.length + \"  ·  \" + cur.location,\n      closeGallery: () => this.closeGallery(),\n      nextImage: (e) => this.nextImage(e),\n      prevImage: (e) => this.prevImage(e),\n      services: [\n        { title: \"Prodaja stanova\", body: \"Stanovi po celom Nišu, od garsonjere do troiposobnog. Nađemo onaj koji odgovara i lokaciji i budžetu.\", cta: \"Pogledajte stanove ›\", go: () => this.goCat(\"prodaja\") },\n        { title: \"Izdavanje\", body: \"Stanovi i lokali za iznajmljivanje. Ako ste vi zakupac, ne plaćate nam proviziju.\", cta: \"Pogledajte ponudu ›\", go: () => this.goCat(\"izdavanje\") },\n        { title: \"Novogradnja\", body: \"Stanovi u novim zgradama, sa parkingom i uknjiženi. Povežemo vas direktno sa investitorom.\", cta: \"Pogledajte novogradnju ›\", go: () => this.goCat(\"novogradnja\") },\n        { title: \"Kupujemo stanove\", body: \"Prodajete? Otkupljujemo stanove raznih struktura, na svim lokacijama u gradu.\", cta: \"Pošaljite ponudu ›\", go: () => this.goKupujemo() }\n      ],\n      steps: [\n        { num: \"01\", title: \"Kažete šta tražite\", body: \"Deo grada, broj soba, budžet. Tu krećemo, ne od onoga što nama treba da prodamo.\" },\n        { num: \"02\", title: \"Idemo u obilazak\", body: \"Pokažemo tri do četiri stana koja imaju smisla i kažemo i mane svakog.\" },\n        { num: \"03\", title: \"Pregovaramo cenu\", body: \"Stojimo uz vas kod cenkanja sa vlasnikom, da ne platite više nego što treba.\" },\n        { num: \"04\", title: \"Ugovor i ključevi\", body: \"Sredimo overu ugovora kod notara i prenos novca, pa dobijete ključeve.\" }\n      ],\n      testimonials: [\n        { quote: \"Uz pomoć agenta Nikole u jednom danu sam našao stan, potpisao ugovor sa vlasnikom i uselio se. Proviziju nisam platio, jer je za zakupce besplatno. Za svaku preporuku.\", name: \"Stevan Stojanović\", role: \"preduzetnik\" },\n        { quote: \"Supruga i ja smo prodali stan preko Delte vrlo brzo. Agent je bio uz nas kod pregovora, overe ugovora i prenosa novca, tako da smo bili mirni i sve smo završili lako.\", name: \"Miloš Marinković\", role: \"preduzetnik\" },\n        { quote: \"Za ovu agenciju imam samo reči hvale. Profesionalni, brzi, i pre svega pošteni. Sve preporuke.\", name: \"Slaviša Mirković\", role: \"ekonomista\" }\n      ]\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
</body>
</html>